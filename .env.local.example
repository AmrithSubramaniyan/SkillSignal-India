# =============================================================================
# SkillSignal India — Local Dev Environment (.env.local.example)
# =============================================================================
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173
DB_URL=jdbc:postgresql://localhost:5432/skillsignal
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=skill
DB_PASSWORD=skillpass
JWT_SECRET=local-dev-only-secret-key-at-least-32-characters-long-2026
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=skillsignal-session-summary
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_CHECKOUT_GRACE_MS=30000
MAIL_PROVIDER=mailpit
MAILPIT_SMTP_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025

