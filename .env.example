# =============================================================================
# SkillSignal India — Environment Configuration (.env.example)
# Copy to .env and customize for your local environment. Never commit .env!
# =============================================================================

# Server
SERVER_PORT=8080
FRONTEND_URL=http://localhost:5173

# Database
# For Docker / PostgreSQL 16:
# DB_URL=jdbc:postgresql://localhost:5432/skillsignal
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=skill
# DB_PASSWORD=skillpass
#
# Default local fallback (H2 in PostgreSQL compatibility mode when Docker is unavailable):
DB_URL=jdbc:h2:file:./data/skillsignal;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;NON_KEYWORDS=USER,VALUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=skill
DB_PASSWORD=skillpass

# Security & Auth (JWT)
# Must be at least 32 characters (256-bit) for HMAC-SHA256
JWT_SECRET=change-me-in-production-at-least-32-bytes-long-secret-key-2026
JWT_EXPIRATION_HOURS=24
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# File Storage
UPLOAD_DIR=./uploads

# AI Provider (mock | anthropic | openai)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-latest
AI_TIMEOUT_SECONDS=30

# Demo Data Seeding
APP_SEED_DEMO=true

# Sprint 7 — Apache Kafka 3.8.0 (KRaft) & Session Check-out Summary Email
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=skillsignal-session-summary
KAFKA_LISTENER_AUTO_STARTUP=true
KAFKA_ADMIN_AUTO_CREATE=true
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_BEACON_GRACE_SECONDS=30
SESSION_CHECKOUT_GRACE_MS=30000
SESSION_OUTBOX_RELAY_MS=3000
SESSION_IDLE_CHECK_MS=60000
SESSION_MAX_EMAILS_PER_DAY=20
SESSION_MAX_EMAIL_ROWS=50
SESSION_OUTBOX_RETENTION_DAYS=7
