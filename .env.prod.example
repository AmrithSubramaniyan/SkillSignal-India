# =============================================================================
# SkillSignal India — Production / Staging Environment (.env.prod.example)
# Supply real secrets via environment variables or secret manager. Never commit!
# =============================================================================
SERVER_PORT=8080
FRONTEND_URL=https://app.skillsignal.in
DB_URL=jdbc:postgresql://postgres:5432/skillsignal
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=skill
DB_PASSWORD=REPLACE_WITH_STRONG_PROD_DB_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_BYTE_HIGH_ENTROPY_SECRET
AI_PROVIDER=anthropic
AI_API_KEY=REPLACE_WITH_PROD_AI_KEY
APP_SEED_DEMO=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CONSUMER_GROUP=skillsignal-session-summary
SESSION_IDLE_TIMEOUT_MINUTES=15
SESSION_CHECKOUT_GRACE_MS=30000
SESSION_MAX_EMAILS_PER_DAY=20
SESSION_MAX_EMAIL_ROWS=50
SESSION_OUTBOX_RETENTION_DAYS=7

